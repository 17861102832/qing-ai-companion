# 复制本文件为 .env 并填写（.env 不会入库，安全）
# 到 https://platform.deepseek.com 申请 key 后粘贴
DEEPSEEK_API_KEY=sk-please-fill-me

# 模型（可选）：deepseek-v4-flash（快）/ deepseek-v4-pro（深度思考）/ deepseek-chat / deepseek-reasoner / 任意多模态模型名
DEEPSEEK_MODEL=deepseek-v4-flash

# 接口地址（可选，缺省 DeepSeek；也可换任意 OpenAI 兼容地址，如接多模态/自建网关）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 记忆目录（可选）：留空按项目内 memory_knowledge/；填路径则保存到该外部文件夹，跨会话/跨机器持久
#QING_MEM_DIR=
